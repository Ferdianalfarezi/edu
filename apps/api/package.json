{
  "name": "@edu/api",
  "version": "0.0.1",
  "private": true,
  "description": "Teman Sekolah API - NestJS Backend",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:debug": "nest start --debug --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "ts-node -r tsconfig-paths/register src/drizzle/seed.ts",
    "db:reseed-dev": "ts-node -r tsconfig-paths/register src/drizzle/reseed-dev.ts",
    "db:reset-dev-passwords": "ts-node -r tsconfig-paths/register src/drizzle/reset-dev-passwords.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:watch": "jest --selectProjects unit --watch",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:contract": "jest --config jest.contract-mock.config.ts",
    "test:contract:real": "CONTRACT_USE_REAL_DB=true jest --config jest.contract-real.config.ts",
    "test:contract:watch": "jest --config jest.contract-mock.config.ts --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@edu/shared": "workspace:*",
    "@nestjs/bull": "^10.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^5.1.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.30.0",
    "firebase-admin": "^12.0.0",
    "googleapis": "144.0.0",
    "ioredis": "^5.3.2",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.21.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "projects": [
      "<rootDir>/jest.unit.config.ts",
      "<rootDir>/jest.integration.config.ts",
      "<rootDir>/jest.contract-mock.config.ts"
    ]
  }
}
