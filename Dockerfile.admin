# Admin Panel Dockerfile — static SPA served via nginx
# Deploys the Vue.js admin panel as a static site on Railway

FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/admin/package.json ./apps/admin/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile --prod=false

COPY apps/admin/ ./apps/admin/
COPY packages/shared/ ./packages/shared/

# Build shared types first, then admin panel
RUN pnpm --filter @edu/shared build
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm --filter @edu/admin build

# Serve with nginx — use Railway's PORT env variable
FROM nginx:alpine

COPY --from=build /app/apps/admin/dist /usr/share/nginx/html

# nginx config template that uses $PORT from environment
RUN printf 'server {\n\
  listen ${PORT};\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
  location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
    expires 1y;\n\
    add_header Cache-Control "public, immutable";\n\
  }\n\
}\n' > /etc/nginx/templates/default.conf.template

# Remove default nginx config (templates/ will be rendered on startup)
RUN rm -f /etc/nginx/conf.d/default.conf

ENV PORT=80
EXPOSE 80

CMD ["sh", "-c", "envsubst '${PORT}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
