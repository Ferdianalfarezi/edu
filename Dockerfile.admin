# Admin Panel Dockerfile — static SPA served via nginx
# Deploys the Vue.js admin panel as a static site on Railway

FROM node:20-alpine AS build
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN npm install -g pnpm@9
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/admin/package.json ./apps/admin/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile --prod=false

COPY apps/admin/ ./apps/admin/
COPY packages/shared/ ./packages/shared/

# Build shared types first, then admin panel
RUN pnpm --filter @edu/shared build
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm --filter @edu/admin build

# Serve with nginx
FROM nginx:alpine

COPY --from=build /app/apps/admin/dist /usr/share/nginx/html

# Write SPA nginx config
RUN rm -f /etc/nginx/conf.d/default.conf && \
    echo 'server {'                                                  > /etc/nginx/conf.d/spa.conf && \
    echo '    listen 80;'                                           >> /etc/nginx/conf.d/spa.conf && \
    echo '    root /usr/share/nginx/html;'                          >> /etc/nginx/conf.d/spa.conf && \
    echo '    index index.html;'                                    >> /etc/nginx/conf.d/spa.conf && \
    echo '    location / {'                                         >> /etc/nginx/conf.d/spa.conf && \
    echo '        try_files $uri $uri/ /index.html;'                >> /etc/nginx/conf.d/spa.conf && \
    echo '    }'                                                    >> /etc/nginx/conf.d/spa.conf && \
    echo '    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {'   >> /etc/nginx/conf.d/spa.conf && \
    echo '        expires 1y;'                                      >> /etc/nginx/conf.d/spa.conf && \
    echo '        add_header Cache-Control "public, immutable";'    >> /etc/nginx/conf.d/spa.conf && \
    echo '    }'                                                    >> /etc/nginx/conf.d/spa.conf && \
    echo '}'                                                        >> /etc/nginx/conf.d/spa.conf

ENV PORT=80
EXPOSE 80

# Railway sets PORT dynamically — replace listen port at startup
CMD sh -c "sed -i 's/listen 80/listen '\"$PORT\"'/' /etc/nginx/conf.d/spa.conf && nginx -g 'daemon off;'"
