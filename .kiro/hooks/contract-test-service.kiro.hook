{
  "enabled": true,
  "name": "Contract Test on Service Change",
  "description": "Runs contract tests when service files change, since service return types affect the API contract with the frontend.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "apps/api/src/modules/**/*.service.ts"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd apps/api && npx jest --config jest.contract-mock.config.ts --passWithNoTests --forceExit 2>&1 | tail -20",
    "timeout": 30
  }
}